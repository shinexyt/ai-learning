@page
@using AIStudySite.Cms.Components
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/cytoscape/dist/cytoscape.min.css" />
}

@section Scripts {
    <script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>
    <script src="~/js/knowledgeTree.js"></script>
}

<div class="page-heading">
    <h1>@Localizer["AI Knowledge Tree"]</h1>
    <p>@Localizer["Click any node to see tutorials powered by Orchard Core CMS."]</p>
</div>

<component type="typeof(KnowledgeTree)" render-mode="ServerPrerendered" />
